DATABASE_URL="postgresql://neondb_owner:"
REFRESH_TOKEN_SECRET="REFRESH_TOKEN_SECRET_KEY"
ACCESS_TOKEN_SECRET="ACCESS_TOKEN_SECRET_KEY"

# Email Configuration

# Email Service Provider
# Supported: 'gmail', 'outlook', 'yahoo', 'ethereal' (for testing), etc.
EMAIL_SERVICE=gmail

# Email Authentication
# For Gmail: use your email and app-specific password (not your Gmail password)
# Generate app password: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Email Sender Configuration
# FROM address (can be different from EMAIL_USER)
EMAIL_FROM=your-email@gmail.com

# Reply-To address for customer inquiries
EMAIL_REPLY_TO=support@MTWO.com

# Optional: SMTP Configuration (if using custom SMTP provider)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

#for whatsapp related query
WHATSAPP_PHONE_NUMBER_ID =  
WHATSAPP_ACCESS_TOKEN =
WHATSAPP_ADMIN_NUMBER =