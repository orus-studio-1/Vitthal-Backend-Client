model client_assets {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String            @db.Uuid
  category_id       String?           @db.Uuid
  subcategory_id    String?           @db.Uuid
  service_subcategory_id String?      @db.Uuid
  service_category_id String?         @db.Uuid
  asset_name        String
  asset_code        String?           @db.VarChar(100)
  brand             String?
  model_number      String?
  serial_number     String?
  installation_year Int?
  specs             Json              @default("{}")
  location_details  Json              @default("{}")
  documents         Json              @default("[]")
  is_active         Boolean           @default(true)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  product_category  product_category? @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  subcategories     subcategories?    @relation(fields: [subcategory_id], references: [id], onUpdate: NoAction)
  service_subcategory service_subcategories? @relation(fields: [service_subcategory_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  service_category service_categories? @relation(fields: [service_category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users             users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service_tickets   service_tickets[]

    @@index([category_id], map: "idx_client_assets_category")
    @@index([service_subcategory_id], map: "idx_client_assets_service_subcategory")
  @@index([service_category_id], map: "idx_client_assets_service_category")
    @@index([specs], map: "idx_client_assets_specs", type: Gin)
  @@index([user_id], map: "idx_client_assets_user")
}

