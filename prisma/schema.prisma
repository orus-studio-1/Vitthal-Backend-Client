generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model abandoned_reminder_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  source_type    String
  source_item_id String   @db.Uuid
  reminder_type  String   @default("24h_abandoned_reminder")
  sent_at        DateTime @default(now()) @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  users          users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_abandoned_reminder_logs_user")

  @@unique([source_type, source_item_id, reminder_type], map: "unique_abandoned_reminder_source")
  @@index([source_type, source_item_id], map: "idx_abandoned_reminder_logs_source")
  @@index([user_id], map: "idx_abandoned_reminder_logs_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
